  "query": "SELECT w.id,\n                  (SELECT count(*) FROM projects p WHERE p.workspace_id = w.id) AS \"projects!\",\n                  (SELECT max(a.created_at) FROM activity a WHERE a.workspace_id = w.id)\n                      AS last_activity_at\n           FROM workspaces w\n           WHERE w.id = ANY($1)",
