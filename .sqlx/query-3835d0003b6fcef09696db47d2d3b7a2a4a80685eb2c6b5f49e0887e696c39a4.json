  "query": "SELECT o.user_id, a.kind, u.display_name, u.handle FROM workspace_owners o\n           JOIN users u ON u.id = o.user_id\n           JOIN actors a ON a.id = o.user_id\n           WHERE o.workspace_id = $1 AND ($2::uuid IS NULL OR o.user_id > $2)\n           ORDER BY o.user_id\n           LIMIT $3",
