{
  "db_name": "PostgreSQL",
  "query": "SELECT trigger_id, width_bucket(due_at, $2::timestamptz[]) AS \"bucket!\",\n                  count(*) AS \"delivered!\",\n                  count(*) FILTER (WHERE status = 'error') AS \"failed!\",\n                  max(due_at) AS \"last!\"\n           FROM trigger_fires\n           WHERE workspace_id = $1 AND source = 'webhook'\n             AND ($3::bool OR project_id = ANY($4::uuid[]))\n             AND due_at >= $5 AND due_at < $6\n           GROUP BY 1, 2",
