  "db_name": "PostgreSQL",
  "query": "SELECT u.id, u.display_name, u.handle, e.email AS \"email?\", u.status,\n                  EXISTS (SELECT 1 FROM instance_admins a WHERE a.user_id = u.id)\n                      AS \"instance_admin!\",\n                  u.created_at\n           FROM users u\n           LEFT JOIN user_emails e ON e.user_id = u.id AND e.is_primary\n           WHERE u.id = $1",
