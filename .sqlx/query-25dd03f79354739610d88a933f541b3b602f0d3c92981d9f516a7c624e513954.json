{
  "db_name": "PostgreSQL",
  "query": "UPDATE vcs_reports r\n         SET state = 'sending', next_attempt_at = now() + make_interval(secs => $2),\n             updated_at = now()\n         FROM (SELECT job_id, context FROM vcs_reports\n               WHERE next_attempt_at <= now()\n               ORDER BY next_attempt_at\n               LIMIT $1\n               FOR UPDATE SKIP LOCKED) due\n         WHERE r.job_id = due.job_id AND r.context = due.context\n         RETURNING r.job_id, r.context, r.connection_id, r.mode, r.wanted_state, r.sequence,\n                   r.attempts, r.external_id",
