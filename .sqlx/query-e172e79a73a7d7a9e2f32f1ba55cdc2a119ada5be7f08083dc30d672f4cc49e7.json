  "query": "\n            UPDATE pipelines\n            SET project_id = $2,\n                name = $3,\n                nodes = $4,\n                updated_at = $5,\n                version = version + 1\n            WHERE id = $1 AND version = $6\n            RETURNING id, project_id, name,\n                      nodes AS \"nodes: Json<Vec<PipelineNode>>\",\n                      created_at, updated_at, version\n            ",
