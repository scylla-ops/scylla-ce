  "query": "UPDATE pipelines\n         SET name = coalesce($3, name), nodes = coalesce($4, nodes), version = version + 1,\n             updated_at = now()\n         WHERE id = $1 AND version = $2\n         RETURNING id, project_id, workspace_id, created_by, name, nodes, version, created_at,\n                   updated_at",
