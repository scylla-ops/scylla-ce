{
  "db_name": "PostgreSQL",
  "query": "SELECT s.user_id, u.status, s.refresh_hash, s.user_agent,\n                  (s.revoked_at IS NOT NULL OR s.expires_at <= now()) AS \"closed!\"\n           FROM sessions s JOIN users u ON u.id = s.user_id\n           WHERE s.id = $1\n           FOR UPDATE OF s",
