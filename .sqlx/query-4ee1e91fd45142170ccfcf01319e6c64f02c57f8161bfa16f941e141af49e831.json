  "query": "SELECT id, project_id, workspace_id, created_by, name, nodes, version, created_at,\n                updated_at\n         FROM pipelines\n         WHERE ($1::uuid IS NULL OR project_id = $1)\n           AND ($2::uuid IS NULL OR workspace_id = $2)\n           AND ($3::uuid IS NULL OR id > $3)\n         ORDER BY id\n         LIMIT $4",
