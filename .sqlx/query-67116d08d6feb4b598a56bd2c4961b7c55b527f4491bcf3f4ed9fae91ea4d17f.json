  "query": "SELECT e.user_id, u.status, p.hash AS \"hash?\", p.locked_until\n           FROM user_emails e\n           JOIN users u ON u.id = e.user_id\n           LEFT JOIN passwords p ON p.user_id = e.user_id\n           WHERE e.email = $1",
