  "query": "\n            UPDATE project_secrets\n            SET description = COALESCE($2, description),\n                encrypted_value = COALESCE($3, encrypted_value),\n                updated_at = $4\n            WHERE id = $1\n            RETURNING id, project_id, name, description, encrypted_value, created_at, updated_at\n            ",
