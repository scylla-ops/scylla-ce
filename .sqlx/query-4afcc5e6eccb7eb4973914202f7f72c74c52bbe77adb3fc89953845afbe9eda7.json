  "query": "SELECT id, name, slug, created_at, personal_tokens_enabled, time_zone, icon_name,\n                icon_color, icon_image_id\n         FROM workspaces\n         WHERE ($5\n                OR id IN (SELECT workspace_id FROM workspace_owners WHERE user_id = $1)\n                OR id = ANY($2))\n           AND ($3::uuid IS NULL OR id > $3)\n         ORDER BY id\n         LIMIT $4",
