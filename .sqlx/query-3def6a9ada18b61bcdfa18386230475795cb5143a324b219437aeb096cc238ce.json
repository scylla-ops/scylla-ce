  "query": "SELECT e.user_id, u.status,\n                  EXISTS (SELECT 1 FROM passwords p WHERE p.user_id = e.user_id)\n                      AS \"has_password!\"\n           FROM user_emails e JOIN users u ON u.id = e.user_id\n           WHERE e.email = $1",
