{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT p.id, p.project_id, p.name,\n                       p.nodes AS \"nodes: Json<Vec<PipelineNode>>\",\n                       p.created_at, p.updated_at, p.version\n                FROM pipelines p\n                JOIN projects pr ON pr.id = p.project_id\n                WHERE pr.organization_id = $1\n                ORDER BY p.created_at DESC\n                LIMIT $2 OFFSET $3\n                ",
