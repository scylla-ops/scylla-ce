  "query": "SELECT g.scope_id, g.actor_id, r.name\n         FROM role_grants g\n         JOIN roles r ON r.id = g.role_id\n         WHERE g.scope_kind = 'workspace' AND g.scope_id = ANY($1)\n         ORDER BY g.scope_id, lower(r.name), g.actor_id",
