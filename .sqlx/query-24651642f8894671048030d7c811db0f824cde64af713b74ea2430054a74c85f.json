  "query": "SELECT o.user_id, u.display_name, o.created_at FROM workspace_owners o\n         JOIN users u ON u.id = o.user_id\n         WHERE o.workspace_id = $1 AND ($2::uuid IS NULL OR o.user_id > $2)\n         ORDER BY o.user_id\n         LIMIT $3",
