  "query": "SELECT a.id AS \"id!\", a.kind AS \"kind!\",\n                  coalesce(u.display_name, p.name) AS \"display_name?\", u.handle,\n                  coalesce(p.runner, false) AS \"runner!\"\n           FROM actors a\n           LEFT JOIN users u ON u.id = a.id\n           LEFT JOIN apps p ON p.id = a.id\n           WHERE a.id = ANY($1)",
