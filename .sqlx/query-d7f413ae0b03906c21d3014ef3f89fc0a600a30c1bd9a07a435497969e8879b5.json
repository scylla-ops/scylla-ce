  "query": "SELECT p.slug, p.display_name, e.subject, e.email, e.picture_url, e.linked_at\n         FROM external_identities e\n         JOIN identity_providers p ON p.id = e.provider_id\n         WHERE e.user_id = $1\n         ORDER BY e.linked_at, p.slug",
