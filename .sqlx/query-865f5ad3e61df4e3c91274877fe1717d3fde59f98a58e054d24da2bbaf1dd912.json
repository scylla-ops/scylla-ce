  "query": "SELECT id, workspace_id, created_by, name, visibility, team_default, version,\n                created_at, updated_at\n         FROM dashboards\n         WHERE workspace_id = $1\n           AND (visibility = 'workspace' OR created_by = $2)\n           AND ($3::uuid IS NULL OR id > $3)\n         ORDER BY id\n         LIMIT $4",
