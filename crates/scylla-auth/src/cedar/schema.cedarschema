// scylla — Cedar schema (V1). Validated against policies at startup.
//
// Entities form the tenancy hierarchy Pipeline ∈ Project ∈ Organization,
// Job ∈ Pipeline, Trigger ∈ Pipeline, Secret ∈ Project,
// AppSecret ∈ App, Grant ∈ its scope and Role ∈ its owner. Principals carry no attributes: what someone may
// do comes entirely from the grants linked into the policy set. Actions are
// fine-grained (one per use-case operation) so `appliesTo` pins the resource
// type and policies stay readable.

namespace Scylla {
    entity Service;
    // Tenancy root. Every Organization is `in` System, so a System-scoped grant
    // (system-admin) reaches the whole tree — the unified replacement for the
    // former global role.
    entity System;

    // Machine principal (agent / automation) owned by an organization. As a
    // principal it carries scoped grants like a User (no ABAC attributes); as a
    // resource it lives under its org, so org-admins manage it via the hierarchy.
    //
    // Every resource sits under its nearest known ancestor. An unknown resource
    // sits under System, so only a System grant reaches it. A grant sits under
    // the scope it is bound at; a System grant sits under System.
    entity App in [Organization, System];

    entity Organization in [System];
    entity Project in [Organization, System];
    entity Pipeline in [Project, System];
    entity Job in [Pipeline, System];
    entity Secret in [Project, System];
    entity Trigger in [Pipeline, System];
    entity AppSecret in [App, System];
    entity Grant in [Project, Organization, System];
    // A role with no owner is a platform role and sits under System.
    entity Role in [Organization, System];

    // Users are also `in [System]` so a System-scoped grant (system-admin)
    // reaches User-targeted actions (read/update/delete user) — without it,
    // System would only cover the org subtree, not user management.
    //
    // A user carries no attributes: authorization reads grants, never who the
    // principal belongs to, so there is nothing to materialise per request.
    entity User in [System];

    // ── System-scoped (admin / service) ────────────────────────────────
    action "createUser", "listUsers",
           "createOrganization", "listOrganizations",
           "listProjects", "listPipelines",
           "createJob", "listJobs"
        appliesTo { principal: [User, Service], resource: [System] };

    // A platform role is managed on System, a role of an organization on that
    // organization. A change to one role is checked on the role, with the action
    // of its owner, so an organization admin reaches only its own roles.
    action "manageRoles"
        appliesTo { principal: [User, Service], resource: [System, Role] };
    action "manageOrgRoles"
        appliesTo { principal: [User, Service], resource: [Organization, Role] };

    // Grant management is scope-aware, one action per scope so `appliesTo` pins
    // the resource type: a system admin manages any grant (`manageSystemGrants`
    // on System); an org/project admin manages grants within their scope
    // (`manageOrgGrants` on Organization / `manageProjectGrants` on Project).
    // Cedar `resource in ?resource` on the role template confines each admin to
    // its own subtree, so an org admin cannot touch another org's grants
    // (anti-escalation). The UI presents the three as one "manage grants".
    // A revoke is checked on the grant, with the action of the grant's scope
    // kind, so the same grants reach it.
    action "manageSystemGrants"
        appliesTo { principal: [User, Service], resource: [System, Grant] };
    action "manageOrgGrants"
        appliesTo { principal: [User, Service], resource: [Organization, Grant] };
    action "manageProjectGrants"
        appliesTo { principal: [User, Service], resource: [Project, Grant] };

    // ── User-targeted ──────────────────────────────────────────────────
    action "readUser", "updateUser", "deleteUser",
           "listUserOrganizations", "listUserProjects"
        appliesTo { principal: [User, Service], resource: [User] };

    // ── Organization-targeted ──────────────────────────────────────────
    action "readOrganization", "updateOrganization", "deleteOrganization",
           "listOrganizationMembers",
           "createProject", "createApp", "createAgent",
           "listProjectsByOrganization", "listPipelinesByOrganization", "listJobsByOrganization",
           "listAppsByOrganization", "listAgents"
        appliesTo { principal: [User, Service], resource: [Organization] };

    // ── Project-targeted ───────────────────────────────────────────────
    action "readProject", "updateProject", "deleteProject",
           "listProjectMembers", "createPipeline",
           "listPipelinesByProject", "listJobsByProject",
           "createSecret", "listSecrets"
        appliesTo { principal: [User, Service], resource: [Project] };

    // ── Pipeline-targeted ──────────────────────────────────────────────
    action "updatePipeline", "deletePipeline", "listJobsByPipeline"
        appliesTo { principal: [User, Service], resource: [Pipeline] };
    // Also grantable to Apps: agents read the pipeline + execute its jobs.
    action "readPipeline", "executeJob"
        appliesTo { principal: [User, Service, App], resource: [Pipeline] };

    // ── Pipeline- or trigger-targeted ──────────────────────────────────
    // An action on one trigger is checked on the trigger, which is in its
    // pipeline, so a grant on the pipeline's project reaches it. A
    // trigger-runner App runs the pipeline (runPipeline) when a trigger fires.
    action "manageTriggers"
        appliesTo { principal: [User, Service], resource: [Pipeline, Trigger] };
    action "runPipeline"
        appliesTo { principal: [User, Service, App], resource: [Pipeline, Trigger] };

    // ── Job-targeted ───────────────────────────────────────────────────
    action "readJob", "updateJob", "deleteJob", "readJobLogs", "writeJobLogs"
        appliesTo { principal: [User, Service], resource: [Job] };
    // Status reports and log appends are also grantable to agent Apps. Kept
    // distinct from the User/Service `updateJob` / `writeJobLogs` above so an
    // agent gets ONLY these, never full job mutation or the recorder path.
    action "writeJobStatus", "appendJobLog"
        appliesTo { principal: [User, Service, App], resource: [Job] };

    // ── Secret-targeted ────────────────────────────────────────────────
    action "deleteSecret"
        appliesTo { principal: [User, Service], resource: [Secret] };

    // ── App-targeted (manage a specific app within its org) ─────────────
    // An agent is a specialized app, so reading/deleting an agent and reading
    // its run stats reuse the App-targeted actions (agent_app_id == app id).
    action "readApp", "readAppStats"
        appliesTo { principal: [User, Service], resource: [App] };

    // ── App- or app-secret-targeted ────────────────────────────────────
    // A revoke or a toggle of one secret is checked on the secret, which is in
    // its app, so a grant on the app's organization reaches it.
    action "deleteApp"
        appliesTo { principal: [User, Service], resource: [App, AppSecret] };
}
